.{
    .name = .http3_zig,
    .version = "0.4.9",
    .fingerprint = 0x71cd45b0dc74266b,
    .minimum_zig_version = "0.17.0-dev.1683+5ceec001b",
    .dependencies = .{
        // quic 0.12.0 — the shape release, and the first tag under the
        // renamed package identity: the package is `.quic` now (dep key,
        // b.dependency("quic"), module "quic", @import("quic")); the repo
        // is still github.com/nullstyle/quic-zig. The rename changed
        // .name/.fingerprint, so this is a new package identity — the hash
        // has no continuity with the old quic_zig-* pins. Inherits 0.11.0
        // (which http3-zig skipped): CUBIC + pacing + HyStart++ as
        // wire-behavior defaults, batched UDP datapath, O(1) sent-packet
        // tracker, TimerKind.pacing. New in 0.12.0: BBRv3 (opt-in via
        // congestion_control = .bbr), Connection address-for-life
        // (createClient/createServer/destroy replace init-then-bind;
        // Client/Server wrappers unaffected), and bundled UDP loops that
        // tolerate peer-provoked receive/send socket errors.
        //
        // http3-zig's only reach into quic internals is
        // quic.conn.state.Error (src/session.zig), which is unaffected.
        //
        // To bump: run `zig fetch <git-url>#<ref>` and paste its hash here
        // by hand — do NOT `zig fetch --save`, which mangles a dependency
        // entry. Also update the quic_build_options "version" string in
        // build.zig to the new release (tools/check-boringssl-pin.sh lints
        // this on tag pins) and mirror any boringssl_zig pin change below
        // byte-for-byte.
        .quic = .{
            .url = "git+https://github.com/nullstyle/quic-zig.git#v0.12.0",
            .hash = "quic-0.12.0-DnSYvceUKwDfkGRGLtid8dcB27U2i04DZ4W_bUu7EpeN",
        },
        // MUST match quic's boringssl_zig entry byte-for-byte so the
        // package manager dedupes to a single boringssl module instance;
        // http3-zig crosses boringssl.tls.Context into quic, so a
        // mismatch yields "expected boringssl.tls.Context, found
        // boringssl.tls.Context" type errors at the boundary.
        //
        // Commit-SHA tarball rather than a tag: quic pins boringssl-zig
        // 0.6.5 at 292c70a2 (the native-Windows pkg-config linker fix,
        // which landed before boringssl-zig cut its next release tag).
        .boringssl_zig = .{
            .url = "https://github.com/nullstyle/boringssl-zig/archive/292c70a2fbe8e48c4efc482c9e5f450e1f22bc6b.tar.gz",
            .hash = "boringssl_zig-0.6.5-4iEdPEz1AQDkuuIR0qV6v4sv7Iy9mxOl2-bX2yZW1xCG",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
        "README.md",
        "ROADMAP.md",
        "CHANGELOG.md",
        "SECURITY.md",
        "CONTRIBUTING.md",
    },
}
