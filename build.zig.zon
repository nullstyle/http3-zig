.{
    .name = .http3_zig,
    .version = "0.5.4",
    .fingerprint = 0x71cd45b0dc74266b,
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        // quic — latest release. v0.30.1 (a probe timeout is not a loss,
        // RFC 9002 6.2.4; the handshake probe timeout is bounded at ~1 s;
        // behavior only, same API and option map), v0.29.0 (a connection
        // costs ~91 KB of Zig heap, not ~1.1 MB; late packets are not lost
        // packets; clients connect through loss), v0.28.1 (v0.28.0 with its
        // 32-bit build fixed: v0.28.0 failed to compile for
        // x86-linux-musl), v0.28.0
        // (the end of a stream cannot be lost: `streamRecvEnd` answers
        // after the reclaiming tick, and `runUdpClient` calls its hook
        // before `tick`), v0.27.0 (session
        // tickets that live through a restart; 0-RTT data goes early
        // behind a Retry) and
        // v0.26.0 ("every legal peer connects": RFC 9000/9001 repairs)
        // on top of v0.25.0's security fix for
        // pre-authentication datagrams (one forged short-header datagram
        // made `Connection.handle` fail; now it is dropped) and the
        // v0.24 stream-limit window (no lifetime stream cap;
        // StreamLimitExceeded is always temporary).
        //
        // To bump: run `tools/fetch-package-hash.sh <url>` and paste its
        // hash here by hand — do NOT `zig fetch --save`, which mangles a
        // dependency entry. The helper isolates `zig fetch` from the build
        // cache: current Zig master can otherwise recompress a GitHub
        // tarball with its original root directory still nested inside,
        // making the next build report a misleading N-V hash mismatch.
        // Also put the same url and hash in
        // tools/coexist-smoke/sibling/build.zig.zon, and mirror any
        // boringssl pin change below byte-for-byte
        // (tools/check-boringssl-pin.sh checks both).
        // Owner policy (2026-10-06): the quic packages (capnp-zig,
        // http3-zig, qmsg, qmesh-zig, nest, mruby-quic) move to a new
        // quic tag together and release after all agree, so one program
        // can link any of them with one quic. Exception: a security fix
        // may tag first.
        // Tarball URL form (not `git+…#tag`): release tags are annotated,
        // and the git form resolves them to a different (unnamed N-V)
        // fingerprint than the release tarball the upstream announcement
        // hashes. The tarball is the canonical pin form upstream
        // publishes — same convention as boringssl below.
        .quic = .{
            .url = "https://github.com/nullstyle/quic-zig/archive/refs/tags/v0.30.1.tar.gz",
            .hash = "quic-0.30.1-DnSYvVnOOwBfpDxHQWI41E6YxM1RqqkCuven5bK46jXR",
        },
        // build.zig does NOT use this entry: BoringSSL comes from quic's
        // exported `boringssl` module, so there is one BoringSSL by
        // construction. The entry stays as the record of the pin we
        // expect, and quic-zig's pin-lint workflow reads it (it fails
        // when the entry is missing). Keep it byte-for-byte equal to
        // quic's entry; remove it only together with quic-zig.
        //
        // Commit-SHA tarball rather than a tag: this is the boringssl-zig
        // 0.6.7 package at ff30fe9, exactly the entry quic v0.30.1 pins.
        .boringssl = .{
            .url = "https://github.com/nullstyle/boringssl-zig/archive/ff30fe9953b07f838d7ac09ace84dacfb1e896ca.tar.gz",
            .hash = "boringssl-0.6.7-Vv5DN8RMAgDGST3F3NpoMjez8Z_J60megIom9Ru9XqD2",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
        "README.md",
        "ROADMAP.md",
        "CHANGELOG.md",
        "SECURITY.md",
        "CONTRIBUTING.md",
    },
}
