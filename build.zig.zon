.{
    .name = .http3_zig,
    .version = "0.4.9",
    .fingerprint = 0x71cd45b0dc74266b,
    .minimum_zig_version = "0.17.0-dev.1978+c961124d9",
    .dependencies = .{
        // quic — latest release. This brings in the BBRv3 default,
        // zero-copy stream reads, receive-side DATAGRAM shedding,
        // SO_REUSEPORT support, and bounded handshake liveness from the
        // 0.14.0–0.19.0 release series.
        //
        // To bump: run `tools/fetch-package-hash.sh <url>` and paste its
        // hash here by hand — do NOT `zig fetch --save`, which mangles a
        // dependency entry. The helper isolates `zig fetch` from the build
        // cache: current Zig master can otherwise recompress a GitHub
        // tarball with its original root directory still nested inside,
        // making the next build report a misleading N-V hash mismatch.
        // Also update the quic_build_options "version" string in build.zig
        // (tools/check-boringssl-pin.sh lints this on tag pins) and mirror
        // any boringssl pin change below byte-for-byte.
        // Tarball URL form (not `git+…#tag`): release tags are annotated,
        // and the git form resolves them to a different (unnamed N-V)
        // fingerprint than the release tarball the upstream announcement
        // hashes. The tarball is the canonical pin form upstream
        // publishes — same convention as boringssl below.
        .quic = .{
            .url = "https://github.com/nullstyle/quic-zig/archive/refs/tags/v0.19.0.tar.gz",
            .hash = "quic-0.19.0-DnSYvfDZMADCQvF3_9ZQ75Kwdz3nJ4CBLSwxWizuCsLI",
        },
        // MUST match quic's boringssl entry byte-for-byte so the
        // package manager dedupes to a single boringssl module instance;
        // http3-zig crosses boringssl.tls.Context into quic, so a
        // mismatch yields "expected boringssl.tls.Context, found
        // boringssl.tls.Context" type errors at the boundary.
        //
        // Commit-SHA tarball rather than a tag: the latest boringssl-zig
        // revision is the unreleased 0.6.5 package at b47af8c. It carries
        // the SSL_get_client_random binding and the `boringssl` package
        // identity expected by quic 0.19.0.
        .boringssl = .{
            .url = "https://github.com/nullstyle/boringssl-zig/archive/87d15bf7cdd7a65687d5921d3389dea7982b2c2d.tar.gz",
            .hash = "boringssl-0.6.6-Vv5DNx8KAgCi6qYllvBlOXf0DwfFhk8OJ_sY5HGR7Kqh",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
        "README.md",
        "ROADMAP.md",
        "CHANGELOG.md",
        "SECURITY.md",
        "CONTRIBUTING.md",
    },
}
